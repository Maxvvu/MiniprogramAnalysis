.page { padding: 24rpx; }.card { margin-bottom: 18rpx; padding: 26rpx; background:#fff; border-radius:16rpx; }.name { font-size:36rpx; font-weight:600; }.type,.muted { margin-top:10rpx; color:#9aa3af; font-size:25rpx; }.title { font-size:29rpx; font-weight:600; margin-bottom:18rpx; }.content,.item { color:#4b5563; font-size:26rpx; line-height:1.65; white-space:pre-wrap; margin-bottom:10rpx; }.input { width:100%; min-height:150rpx; box-sizing:border-box; padding:18rpx; background:#f5f7fa; border-radius:10rpx; font-size:26rpx; }.button { margin-top:18rpx; background:#2b6de5; color:#fff; font-size:28rpx; }
