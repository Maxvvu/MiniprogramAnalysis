.page {
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #e5e8ee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #5a6270;
  font-size: 28rpx;
}

.tab.active {
  color: #2b6de5;
  font-weight: 600;
  border-bottom: 4rpx solid #2b6de5;
}

.card {
  margin: 24rpx;
}

.stat-row {
  display: flex;
  gap: 20rpx;
}

.stat {
  flex: 1;
  text-align: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.stat .num {
  font-size: 40rpx;
  font-weight: 600;
  color: #2b6de5;
}

.stat .label {
  font-size: 24rpx;
  color: #9aa3af;
  margin-top: 6rpx;
}

.user-row {
  border-bottom: 2rpx solid #f0f2f5;
  padding: 20rpx 0;
}

.user-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
}

.user-sub {
  font-size: 24rpx;
  color: #9aa3af;
}

.quota-line {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  align-items: center;
}

.quota-input {
  flex: 1;
  border: 2rpx solid #e5e8ee;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.mini-btn {
  padding: 10rpx 24rpx;
  background: #2b6de5;
  color: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: #5a6270;
  margin: 20rpx 0 8rpx;
}

.input {
  border: 2rpx solid #e5e8ee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.input.search {
  margin-bottom: 20rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e5e8ee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  height: 200rpx;
  font-size: 26rpx;
}

.switch-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0;
  font-size: 28rpx;
}

.btn-primary {
  margin-top: 24rpx;
}

.k-row {
  border-bottom: 2rpx solid #f0f2f5;
  padding: 20rpx 0;
}

.k-title {
  font-size: 28rpx;
  font-weight: 500;
}

.k-sub {
  font-size: 24rpx;
  color: #9aa3af;
  margin: 6rpx 0 10rpx;
}

.empty {
  text-align: center;
  color: #9aa3af;
  font-size: 26rpx;
  padding: 30rpx 0;
}

/* 报告反馈 */
.fb-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.fb-filter-btn {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5a6270;
  background: #f0f2f6;
}

.fb-filter-btn.active {
  background: #2b6de5;
  color: #fff;
}

.fb-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef1f5;
}

.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fb-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2733;
}

.fb-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f2f6;
  color: #6b7683;
}

.fb-status.fb-pending {
  background: rgba(43, 109, 229, 0.12);
  color: #2b6de5;
}

.fb-status.fb-adopted {
  background: rgba(31, 157, 107, 0.12);
  color: #1f9d6b;
}

.fb-meta {
  font-size: 24rpx;
  color: #9aa3af;
  margin-top: 8rpx;
}

.fb-comment {
  font-size: 26rpx;
  color: #303a45;
  line-height: 1.6;
  margin-top: 12rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.fb-comment.fb-empty {
  color: #9aa3af;
  background: transparent;
  padding: 8rpx 0;
}

.fb-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mini-btn.ghost {
  background: #fff;
  color: #d4483b;
  border: 2rpx solid #f0c4c0;
}
