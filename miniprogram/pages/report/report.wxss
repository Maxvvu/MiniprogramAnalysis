.page {
  padding-bottom: 80rpx;
}

.progress-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e5e8ee;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.progress-tip {
  margin-top: 24rpx;
  text-align: center;
}

.steps {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin: 40rpx 0 24rpx;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa3af;
  background: #eef0f3;
}

.step.done .step-dot {
  background: var(--brand);
  color: #fff;
}

.step.current .step-dot {
  background: #fff;
  color: var(--brand);
  border: 4rpx solid var(--brand);
}

.step-label {
  font-size: 22rpx;
  color: #9aa3af;
}

.step.current .step-label {
  color: var(--brand);
  font-weight: 600;
}

.step.done .step-label {
  color: #5a6270;
}

.progress-elapsed {
  margin-top: 12rpx;
}

.cancel-btn {
  margin-top: 32rpx;
  background: #fff;
  color: #5a6270;
  border: 2rpx solid #d5dae2;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.retry-btn {
  margin-top: 40rpx;
}

/* 报告抬头：品牌渐变 hero 卡片 */
.report-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx;
  padding: 56rpx 32rpx 44rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1b4d7e 0%, #143a60 100%);
  box-shadow: 0 10rpx 30rpx rgba(20, 58, 96, 0.24);
}

.report-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
}

.report-meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.rating-badge {
  margin-top: 24rpx;
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.rating-S {
  background: #d4380d;
  border-color: #d4380d;
}

.rating-A {
  background: #f0a020;
  border-color: #f0a020;
  color: #4a3000;
}

.rating-B {
  background: #ffffff;
  border-color: #ffffff;
  color: #143a60;
}

.rating-C {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.4);
}

.content {
  line-height: 1.8;
  color: #3a4150;
  font-size: 28rpx;
}

.sub-title {
  position: relative;
  font-weight: 600;
  margin: 28rpx 0 14rpx;
  padding-left: 18rpx;
  color: var(--brand);
}

.sub-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--brand);
}

.bullet {
  line-height: 1.75;
  color: #3a4150;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
}

.objection-item {
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
}

.objection-q {
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10rpx;
}

.objection-a {
  color: #3a4150;
  line-height: 1.7;
}

.download-area {
  margin: 48rpx 24rpx 0;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin: 60rpx 24rpx 8rpx;
}

.solution-card {
  border-top: 6rpx solid var(--brand);
}

.solution-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}

.btn-secondary {
  margin-top: 20rpx;
}

/* 报告反馈闭环 */
.feedback-card {
  margin-top: 24rpx;
}

.feedback-tip {
  margin: 8rpx 0 20rpx;
  line-height: 1.6;
}

.rating-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.rating-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid var(--brand-line);
  background: #fafbfc;
  color: var(--text-sub);
  font-size: 28rpx;
}

.rating-chip.active-useful {
  border-color: var(--success);
  background: rgba(31, 157, 107, 0.1);
  color: var(--success);
  font-weight: 600;
}

.rating-chip.active-improve {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.feedback-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx;
  background: #fafbfc;
  border: 2rpx solid var(--brand-line);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

.feedback-submit {
  margin-top: 20rpx;
}

.feedback-done {
  margin-top: 16rpx;
  color: var(--success);
}
