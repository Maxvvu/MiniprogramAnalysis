.page {
  padding-bottom: 60rpx;
}

.top-header {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx 0;
}

.admin-entry {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  color: var(--brand);
  font-size: 24rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: 999rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  background: #fafbfc;
}

.input-ph {
  color: #9aa3af;
  font-size: 28rpx;
}

.type-title {
  margin-top: 40rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 24rpx 24rpx;
  height: 180rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #fafbfc;
}

.submit-area {
  margin: 48rpx 24rpx 0;
}

.submit-tip {
  text-align: center;
  margin-top: 20rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(9, 30, 54, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(9, 30, 54, 0.3);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text);
}

.modal-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  text-align: center;
  margin: 14rpx 0 32rpx;
  line-height: 1.6;
}

.modal .btn-primary {
  margin-top: 32rpx;
}

.modal-skip {
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
  margin-top: 28rpx;
}
