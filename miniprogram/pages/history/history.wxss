.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.search-bar {
  flex: 1;
}

.search-input {
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  background: #fff;
}

.clear-btn {
  color: var(--text-sub);
  font-size: 26rpx;
  white-space: nowrap;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: #fff;
}

.empty-tip {
  text-align: center;
  color: var(--text-sub);
  padding-top: 200rpx;
  white-space: pre-line;
  line-height: 1.8;
}

.item {
  padding: 30rpx 32rpx;
}

.item-top {
  display: flex;
  align-items: center;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-badge {
  background: linear-gradient(135deg, #2f6db5, #143a60);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
}

.item-status {
  font-size: 24rpx;
  font-weight: 500;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.stage-text {
  margin-top: 10rpx;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.delete-btn {
  color: var(--danger);
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid #f0d5d2;
  border-radius: 999rpx;
}
