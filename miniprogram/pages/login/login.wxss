.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 220rpx;
  background: linear-gradient(180deg, #eaf1fd 0%, #f5f7fa 60%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #2b6de5;
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: #8a919f;
  font-size: 26rpx;
}

.login-btn {
  width: 560rpx;
}

.tip {
  margin-top: 24rpx;
}
