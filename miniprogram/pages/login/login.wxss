.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  background: linear-gradient(170deg, #143a60 0%, #1b4d7e 34%, #eef1f5 34%, #eef1f5 100%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}

.logo {
  width: 148rpx;
  height: 148rpx;
  border-radius: 36rpx;
  background: #ffffff;
  color: #1b4d7e;
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(9, 30, 54, 0.28);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #8a919f;
  font-size: 26rpx;
}

/* 底部登录卡片，商务留白 */
.login-btn {
  width: 100%;
  max-width: 600rpx;
  margin-top: auto;
  margin-bottom: 120rpx;
}

.tip {
  margin-top: 24rpx;
}
