/* ===== 商务专业设计系统（To B · 稳重）===== */
page {
  /* 品牌色：深商务蓝，稳重可信 */
  --brand: #1b4d7e;
  --brand-deep: #143a60;
  --brand-soft: #eef3f9;
  --brand-line: #d8e3f0;
  /* 中性色 */
  --bg: #eef1f5;
  --card: #ffffff;
  --text: #1a2733;
  --text-sub: #6b7683;
  --line: #e7ebf0;
  /* 语义色 */
  --success: #1f9d6b;
  --warn: #c8933f;
  --danger: #d4483b;

  background: var(--bg);
  font-size: 28rpx;
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;
}

/* ===== 卡片 ===== */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin: 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 6rpx 24rpx rgba(20, 58, 96, 0.05);
}

/* ===== 主按钮：深蓝渐变 + 沉稳阴影 ===== */
.btn-primary {
  background: linear-gradient(135deg, #1f5488 0%, #143a60 100%);
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 92rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 58, 96, 0.22);
}

.btn-primary[disabled] {
  background: #b6c4d4;
  color: #f0f3f7;
  box-shadow: none;
}

/* ===== 次级按钮：描边 ===== */
.btn-secondary {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--brand-line);
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

/* ===== 标题：左侧品牌色竖条，强化结构感 ===== */
.section-title {
  position: relative;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  padding-left: 20rpx;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6db5, #143a60);
}

.text-secondary {
  color: var(--text-sub);
  font-size: 24rpx;
}
